@{
    ViewBag.Title = "Thêm loại sự kiện";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white">

                    <h4 class="mb-0">
                        Thêm loại sự kiện
                    </h4>

                </div>


                <div class="card-body">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }


                    @using (Html.BeginForm(
                        "Create",
                        "Categories",
                        new { area = "Admin" },
                        FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()


                        <div class="form-group">

                            <label class="font-weight-bold">
                                Tên loại sự kiện
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   name="name"
                                   class="form-control"
                                   placeholder="Ví dụ: Học thuật"
                                   value="@Request.Form["name"]"
                                   required />

                            <small class="form-text text-muted">

                                Ví dụ: Học thuật, Việc làm,
                                Thể thao, Văn hóa, Tình nguyện...

                            </small>

                        </div>


                        <div class="alert alert-info">

                            Loại sự kiện mới sẽ được đặt ở trạng thái
                            <strong>Đang hoạt động</strong> và Staff có thể
                            chọn ngay khi tạo sự kiện.

                        </div>


                        <hr />


                        <div class="d-flex justify-content-between">

                            @Html.ActionLink(
                                "← Quay lại",
                                "Index",
                                "Categories",
                                new { area = "Admin" },
                                new
                                {
                                    @class =
                                        "btn btn-outline-secondary"
                                }
                            )


                            <button type="submit"
                                    class="btn btn-primary">

                                Thêm loại sự kiện

                            </button>

                        </div>

                    }

                </div>

            </div>

        </div>

    </div>

</div>